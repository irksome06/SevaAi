# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Replace with your local or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/sevaai

# JWT Authentication Secret & Expiration
JWT_SECRET=sevaai_super_secure_jwt_secret_key_2025_citizen_platform
JWT_EXPIRES_IN=7d

# SMS Provider Configuration
# Use 'mock' for local development (the UI displays MOCK_OTP_CODE). Configure
# a real provider only for production deployments.
# Options: 'mock', 'fast2sms', 'twilio', 'msg91', 'twofactor'
SMS_PROVIDER=mock
MOCK_OTP_CODE=123456

# AI Assistant — free and local with Ollama (no API key or paid credits needed)
# Install Ollama from https://ollama.com, then run: ollama pull llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# Keep the small local model loaded between questions and bound slow generations.
OLLAMA_KEEP_ALIVE=30m
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RESPONSE_TOKENS=160

# Twilio (recommended: use an E.164 sender, for example +1415...)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+14155550123

# Alternative provider keys
# FAST2SMS_API_KEY=your_fast2sms_api_key
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_dlt_template_id
# TWOFACTOR_API_KEY=your_2factor_api_key
